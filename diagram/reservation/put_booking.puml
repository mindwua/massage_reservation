@startuml

title "Manage Message Rervation(PUT)"

participant Client
participant Server
participant ReservationRouter as "ReservationRouter"
participant Middleware
participant ReservationController as "ReservationController"
participant ReservationModel as "ReservationModel"
participant SlackService
database "<<MongoDB>>\n:reservations" as ReservationDatabase


Client -> Server: req.put('/api/v1/booking/:id')
activate Server
Server -> ReservationRouter: app.use("/api/v1", verifyToken, validateParam, updateReservation)
activate ReservationRouter

ReservationRouter -> Middleware: verifyToken()
activate Middleware
Middleware -> Middleware: Extract token from headers
activate Middleware
deactivate Middleware

alt Token is missing
    Middleware --> Client: 401 Unauthorized (TKN_6001)
else Token is blacklisted
    Middleware --> Client: 401 Unauthorized (TKN_6002)
else Token is valid
    Middleware -> ReservationRouter: next()
    deactivate Middleware
end

ReservationRouter -> Middleware: validateParam(bookingRunningSchema)

activate Middleware
alt Invalid data format
    Middleware --> Client: 400 Invalid data format (VAL_4004)
else data format is valid    
    Middleware -> ReservationRouter:  next()
end
deactivate Middleware

ReservationRouter -> Middleware: validateBody(bodyPutSchema)
activate Middleware
alt Invalid data format
    Middleware --> Client: 400 Invalid data format (VAL_4004)
else data format is valid    
    Middleware -> ReservationRouter:  next()
end
deactivate Middleware

ReservationRouter -> ReservationController: updateReservation(req, res)
deactivate ReservationRouter

activate ReservationController

ReservationController -> ReservationModel: updateWithRole(isAdmin,userId,bookingId,req.body)
activate ReservationModel

alt role Admin
    ReservationModel -> ReservationModel: findOneAndUpdate(date, shopId, userId)
    activate ReservationModel
    ReservationModel -> ReservationDatabase: ReservetionSchema
    activate ReservationDatabase
    ReservationDatabase -> ReservationModel: reservation
    deactivate ReservationDatabase
    deactivate ReservationModel
else role User
    ReservationModel -> ReservationModel: findOneAndUpdate(date, shopId)
    activate ReservationModel
    ReservationModel -> ReservationDatabase: ReservetionSchema
    activate ReservationDatabase
    ReservationDatabase -> ReservationModel: reservation
    deactivate ReservationDatabase
    deactivate ReservationModel
end

ReservationModel --> ReservationController: Response with reservation data
deactivate ReservationModel

ReservationController -> SlackService: sendSlack()
activate SlackService
deactivate SlackService
' ReservationController --> Server: Response data

alt Update reservation successfully
    ReservationController --> Client: 200 OK (RSV_3010)
else Update reservation failed Reservation not found
    ReservationController --> Client: 404 NOT FOUND (RSV_3004)
else Internal Server Error
    ReservationController -> Client: 500 SERVER_ERROR (GNR_1001)
deactivate ReservationController
end
@enduml
